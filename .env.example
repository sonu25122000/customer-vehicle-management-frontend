# Backend API URL for local dev only — points the Vite dev-server proxy (see
# vite.config.js) at your local backend. The app itself always calls the
# same-origin '/api' path (src/api/client.js), so no CORS setup is needed.
# In production, the equivalent target lives in public/_redirects instead.
VITE_API_BASE_URL=https://customer-vehicle-management-backend.vercel.app/api

# How often (ms) a logged-in session re-checks itself with the server.
# This is what makes "logged in on another device" sign this session out automatically
# instead of waiting for the next click/refresh.
VITE_SESSION_POLL_MS=15000
